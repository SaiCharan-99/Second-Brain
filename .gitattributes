# Normalise text in the repository, check out native on Windows.
* text=auto

# gradlew is a shell script. CRLF makes it unrunnable on macOS/Linux, so it is
# pinned to LF regardless of platform.
gradlew         text eol=lf
*.sh            text eol=lf

gradlew.bat     text eol=crlf

*.kt            text
*.kts           text
*.toml          text
*.md            text
*.xml           text
*.properties    text

*.jar           binary
*.wav           binary
*.png           binary
